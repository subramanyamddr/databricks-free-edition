{
  "pipeline_name": "retail_pipeline",
  "log_level": "INFO",
  "log_container": "pipeline-logs",

  "bronze_schema": "bronze",
  "silver_schema": "silver",
  "gold_schema": "gold",
  "quarantine_schema": "quarantine",

  "bronze_table": "sales_raw",
  "silver_table": "sales_cleaned",
  "quarantine_table": "sales_quarantine",

  "dim_customer_table": "dim_customer",
  "dim_product_table": "dim_product",
  "dim_store_table": "dim_store",
  "dim_date_table": "dim_date",
  "fact_sales_table": "fact_sales",

  "source_container": "raw-data",
  "source_path": "sales/",

  "silver_watermark_days": 1,
  "dq_min_pass_rate_pct": 80.0,
  "optimize_on_write": "false",

  "dim_date_start": "2023-01-01",
  "dim_date_end": "2026-12-31",

  "spark_conf": {
    "spark.sql.shuffle.partitions": "8",
    "spark.databricks.delta.optimizeWrite.enabled": "true",
    "spark.databricks.delta.autoCompact.enabled": "true"
  }
}
